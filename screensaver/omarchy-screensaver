#!/usr/bin/env python3
"""Trace OMARCHY as a continuous path of ASCII rail."""

import curses
import shutil
import subprocess
import time


GLYPHS = {
    "O": ("#######", "#.....#", "#.....#", "#.....#", "#.....#", "#.....#", "#######"),
    "M": ("#.....#", "##...##", "###.###", "#.###.#", "#.....#", "#.....#", "#.....#"),
    "A": (".#####.", "##...##", "#.....#", "#.....#", "#######", "#.....#", "#.....#"),
    "R": ("#######", "#.....#", "#.....#", "######.", "#..##..", "#...##.", "#....##"),
    "C": ("#######", "#......", "#......", "#......", "#......", "#......", "#######"),
    "H": ("#.....#", "#.....#", "#.....#", "#######", "#.....#", "#.....#", "#.....#"),
    "Y": ("#.....#", "##...##", ".##.##.", "..###..", "...#...", "...#...", "...#..."),
}
LETTER_GAP = 2
ROW_SCALE = 3
FRAME_DELAY = 0.018
TRACE_COLOR, RAIL_COLOR = range(1, 3)


def neighbors(point, cells):
    x, y = point
    for candidate in ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)):
        if candidate in cells:
            yield candidate


def trace_order(cells):
    start = min(cells, key=lambda point: (point[1], point[0]))
    visited = {start}
    route = [start]

    def walk(point):
        for adjacent in sorted(neighbors(point, cells), key=lambda p: (p[1], p[0])):
            if adjacent not in visited:
                visited.add(adjacent)
                route.append(adjacent)
                walk(adjacent)
                route.append(point)

    walk(start)
    return route


def make_word():
    cells = set()
    letters = []
    for letter_index, letter in enumerate("OMARCHY"):
        x_offset = letter_index * (7 + LETTER_GAP)
        letter_cells = {
            (x + x_offset, y)
            for y, row in enumerate(GLYPHS[letter])
            for x, pixel in enumerate(row)
            if pixel == "#"
        }
        letters.append(letter_cells)
        cells.update(letter_cells)

    for left, right in zip(letters, letters[1:]):
        left_edge = max(x for x, _ in left)
        right_edge = min(x for x, _ in right)
        start, end = min(
            ((a, b) for a in left if a[0] == left_edge for b in right if b[0] == right_edge),
            key=lambda pair: abs(pair[0][1] - pair[1][1]),
        )
        step = 1 if end[1] > start[1] else -1
        cells.update((x, start[1]) for x in range(start[0] + 1, right_edge))
        cells.update((right_edge - 1, y) for y in range(start[1], end[1] + step, step))

    return cells, trace_order(cells)


CELLS, ROUTE = make_word()


def rail_char(point, shown):
    adjacent = set(neighbors(point, shown))
    x, y = point
    horizontal = (x - 1, y) in adjacent or (x + 1, y) in adjacent
    vertical = (x, y - 1) in adjacent or (x, y + 1) in adjacent
    if horizontal and vertical:
        return "+"
    if horizontal:
        return "="
    if vertical:
        return "|"
    return "o"


def draw(screen, shown, cursor):
    height, width = screen.getmaxyx()
    screen.erase()
    left = max(0, (width - (7 * 7 + LETTER_GAP * 6)) // 2)
    top = max(0, (height - 7 * ROW_SCALE) // 2)
    for (x, y) in CELLS:
        if (x, y) not in shown:
            continue
        char = "*" if (x, y) == cursor else rail_char((x, y), shown)
        color = TRACE_COLOR if (x, y) == cursor else RAIL_COLOR
        for row in range(top + y * ROW_SCALE, top + (y + 1) * ROW_SCALE):
            try:
                screen.addstr(row, left + x, char, curses.color_pair(color))
            except curses.error:
                pass
    screen.refresh()


def run(screen):
    curses.curs_set(0)
    screen.nodelay(True)
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(TRACE_COLOR, 208, -1)
    curses.init_pair(RAIL_COLOR, 106, -1)

    last_focus_check = 0.0
    while True:
        shown = set()
        for point in ROUTE:
            shown.add(point)
            draw(screen, shown, point)
            deadline = time.monotonic() + FRAME_DELAY
            while time.monotonic() < deadline:
                if screen.getch() != -1:
                    return
                now = time.monotonic()
                if now - last_focus_check > 1:
                    last_focus_check = now
                    try:
                        hyprctl = shutil.which("hyprctl")
                        if hyprctl and "org.omarchy.screensaver" not in subprocess.check_output(
                            [hyprctl, "activewindow", "-j"], stderr=subprocess.DEVNULL, text=True
                        ):
                            return
                    except Exception:
                        pass
                time.sleep(0.01)

        draw(screen, shown, None)
        deadline = time.monotonic() + 2
        while time.monotonic() < deadline:
            if screen.getch() != -1:
                return
            time.sleep(0.05)


if __name__ == "__main__":
    curses.wrapper(run)
